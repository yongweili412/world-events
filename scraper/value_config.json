{
  "version": "archive-value-v1",
  "_comment": "World Events 档案价值评分配置（单一事实源）。改本文件即可重算全库，无需重新抓数据。定位：新闻是来源，事件才是数据；世界影响力决定重要性，时代记忆决定是否值得留下。",

  "eventTypes": {
    "world":           {"label": "世界大事",   "order": 1, "desc": "战争、灾害、重大政治变化、重大科技突破、全球经济事件"},
    "society_culture": {"label": "社会文化",   "order": 2, "desc": "电影、音乐、体育、游戏、消费文化、社会现象"},
    "internet_trends": {"label": "互联网时代", "order": 3, "desc": "爆款视频、网络梗、挑战、社交媒体现象、平台热点"}
  },

  "dimensions": {
    "globalImpact":     "对国际/世界的影响",
    "socialImpact":     "对社会生活的影响",
    "culturalImpact":   "对文化、娱乐、互联网的影响",
    "economicImpact":   "对经济、产业的影响",
    "technologyImpact": "对科技发展的影响",
    "memoryValue":      "是否成为一代人的共同记忆"
  },

  "weights": {
    "globalImpact":     0.20,
    "socialImpact":     0.18,
    "culturalImpact":   0.18,
    "economicImpact":   0.12,
    "technologyImpact": 0.12,
    "memoryValue":      0.20
  },

  "archiveFormula": {
    "weightedPart": 0.40,
    "maxPart": 0.60,
    "min": 0,
    "max": 100,
    "_note": "archiveValue = round(weighted*0.40 + max(六维)*0.60)。校准依据：原 0.60/0.40 会让用户举的「爆火抖音视频」范例只拿 61 分、达不到 KEEP 线，与「网络现象也应入库」定位矛盾。改 0.40/0.60 后：俄乌战争≈85、抖音现象级≈71（可入 KEEP）、产业转折≈66、世界杯≈45、普通车型≈30、搞笑视频≈18，区分度良好。"
  },

  "thresholds": {
    "keep": 70,
    "review": 40,
    "keepMinDim": 70,
    "dropMinConfidence": 80,
    "hardDropMaxScore": 25,
    "hardDropConfidence": 80,
    "softDropConfidence": 65,
    "_note": "KEEP>=70 且满足证据条件；REVIEW 40-69/证据弱/规则与模型冲突/疑似重复；DROP<40 且置信度>=80 且无任何维度>=70",
    "_hardDropNote": "2026-10-06 收紧：规则层原先把 rules_drop 一律按 conf=80 处理，补证让证据变强后一次性新增 136 条 DROP，误杀『微软停止支持Win10』『NASA韦伯望远镜首图』『泰国前市长判死刑』等真实事件。改为：只有 综合分<25 + 命中明确商业噪声 + 证据非弱 才给 conf=80 真判 DROP；其余 rules_drop 降到 conf=65，decide() 自动落到 REVIEW——宁可 REVIEW 不误杀。"
  },

  "categoryPriors": {
    "_default":      {"globalImpact": 15, "socialImpact": 20, "culturalImpact": 15, "economicImpact": 10, "technologyImpact": 10, "memoryValue": 15},
    "军事":          {"globalImpact": 55, "socialImpact": 50, "culturalImpact": 10, "economicImpact": 20, "technologyImpact": 15, "memoryValue": 45},
    "冲突":          {"globalImpact": 45, "socialImpact": 45, "culturalImpact": 10, "economicImpact": 18, "technologyImpact": 12, "memoryValue": 40},
    "国际关系":      {"globalImpact": 55, "socialImpact": 25, "culturalImpact": 10, "economicImpact": 25, "technologyImpact": 10, "memoryValue": 25},
    "国际政治":      {"globalImpact": 55, "socialImpact": 30, "culturalImpact": 10, "economicImpact": 22, "technologyImpact": 10, "memoryValue": 28},
    "政治":          {"globalImpact": 45, "socialImpact": 45, "culturalImpact": 10, "economicImpact": 20, "technologyImpact": 10, "memoryValue": 30},
    "灾难":          {"globalImpact": 35, "socialImpact": 55, "culturalImpact": 10, "economicImpact": 25, "technologyImpact": 10, "memoryValue": 40},
    "自然灾害":      {"globalImpact": 35, "socialImpact": 55, "culturalImpact": 10, "economicImpact": 25, "technologyImpact": 10, "memoryValue": 40},
    "环境":          {"globalImpact": 30, "socialImpact": 40, "culturalImpact": 10, "economicImpact": 20, "technologyImpact": 20, "memoryValue": 30},
    "经济":          {"globalImpact": 30, "socialImpact": 30, "culturalImpact": 10, "economicImpact": 60, "technologyImpact": 20, "memoryValue": 25},
    "科技":          {"globalImpact": 25, "socialImpact": 25, "culturalImpact": 15, "economicImpact": 25, "technologyImpact": 55, "memoryValue": 30},
    "文化":          {"globalImpact": 15, "socialImpact": 25, "culturalImpact": 60, "economicImpact": 15, "technologyImpact": 10, "memoryValue": 50},
    "体育":          {"globalImpact": 20, "socialImpact": 25, "culturalImpact": 50, "economicImpact": 20, "technologyImpact": 10, "memoryValue": 45},
    "社会":          {"globalImpact": 15, "socialImpact": 45, "culturalImpact": 20, "economicImpact": 15, "technologyImpact": 10, "memoryValue": 25},
    "其他":          {"globalImpact": 15, "socialImpact": 20, "culturalImpact": 18, "economicImpact": 10, "technologyImpact": 10, "memoryValue": 18}
  },

  "dimensionKeywords": {
    "globalImpact":     {"war": 25, "conflict": 20, "global": 15},
    "socialImpact":     {"public": 20, "crisis": 18},
    "culturalImpact":   {"culture": 22, "viral": 20},
    "economicImpact":   {"econ": 22, "market": 15},
    "technologyImpact": {"tech": 25, "science": 15},
    "memoryValue":      {"memory": 22, "first": 15}
  },

  "keywordSets": {
