  "rescueKeywords": {
    "_note": "命中任一 → 即使命中商业噪声也升级为边界（交给 LLM 判断），避免误杀产业转型/现象级事件",
    "words": ["首次超过", "首次超越", "超越", "颠覆", "取代", "终结", "里程碑", "历史性", "创纪录", "破纪录", "现象级", "爆红", "刷屏", "出圈", "全民", "一代人", "转折点", "首次实现", "全球首"]
