  "commercialNoise": {
    "_note": "命中这些模式 → 倾向 DROP（普通商业信息/日常内容，不是时代事件）。但若同时命中 memoryKeywords 或 viralKeywords（如成为现象级），应升级为边界交给 LLM。",
    "_splitNote": "2026-10-06 拆分：原 patterns 里『活动/发布/升级/体验/季度』歧义过大（『大脑活动』『新闻发布会』『冲突升级』『抗议活动』『第三季度经济增长』都是正经事件），曾把诺贝尔医学奖误杀成 DROP（av=20）。现按降权力度分两档：patterns=强噪声×0.60（明确商业），ambiguousPatterns=弱噪声×0.85（语义歧义，只轻微降权，绝不单独构成 DROP 依据）。",
    "penaltyStrong": 0.60,
    "penaltyAmbiguous": 0.85,
    "patterns": ["上市", "开售", "预售", "售价", "起售价", "配置", "参数", "试驾", "评测", "测评", "优惠", "促销", "降价", "抽奖", "代言", "代言人", "新品", "新款", "推送", "更新版本", "内测", "公测", "官宣", "亮相"],
    "ambiguousPatterns": ["活动", "发布", "升级", "体验", "季度", "财报", "营收", "利润"]
  },

  "prestige": {
    "_note": "重大奖项 / 里程碑级荣誉：确认『已获奖』（而非提名、预测、入围）时直通 KEEP，并抬到对应地板分。设计理由：奖项类标题不含战争/灾难词，纯靠关键词打分会掉到 20 分区间，再被噪声词一压就判 DROP——这是系统性误杀。弱信号（提名/有望/预测）一律不触发，避免『姆巴佩称仍有望赢得金球奖』之类的八卦被捧成 KEEP。",
    "sciAwards": ["诺贝尔物理学奖", "诺贝尔化学奖", "诺贝尔医学奖", "诺贝尔生理学", "图灵奖", "菲尔兹奖", "拉斯克奖", "沃尔夫奖", "克拉福德奖", "京都奖", "邵逸夫奖", "未来科学大奖", "科学突破奖", "巴尔赞奖"],
    "humanAwards": ["诺贝尔和平奖", "诺贝尔文学奖", "诺贝尔经济学奖", "诺贝尔", "诺奖", "普利策", "格莱美", "奥斯卡", "金球奖", "艾美奖", "托尼奖", "布克奖", "雨果奖", "金棕榈", "金狮", "金熊", "戛纳", "威尼斯电影节", "柏林电影节", "圣丹斯", "劳伦斯", "南丁格尔", "普利兹克", "唐奖"],
    "_winRegexNote": "只认『颁奖动作』，不认『提及获奖者身份』——『诺贝尔奖得主尤努斯出任总理』『诺贝尔奖公布时间安排』这类只是提及，不该被抬成 KEEP，故动词表不含 得主/获奖者/公布/出炉/揭晓。",
    "winRegex": [
      "(获得|授予|荣获|摘得|夺得|获颁|颁授|颁给|花落|获奖|桂冠|夺奖|捧得|摘取|加冕)[^。；，]{0,14}(诺贝尔|诺奖|普利策|图灵|菲尔兹|格莱美|奥斯卡|金球奖|布克奖|雨果奖|艾美奖|托尼奖|金棕榈|金狮|金熊|戛纳|威尼斯|柏林电影节|圣丹斯|劳伦斯|拉斯克|沃尔夫|克拉福德|巴尔赞|京都奖|邵逸夫|未来科学|突破奖)",
      "(诺贝尔|诺奖|普利策|图灵奖?|菲尔兹|格莱美|奥斯卡|金球奖|布克奖|雨果奖|艾美奖|托尼奖|金棕榈|金狮|金熊|戛纳|威尼斯电影节|柏林电影节|圣丹斯|劳伦斯|拉斯克|沃尔夫|克拉福德|巴尔赞|京都奖|邵逸夫|未来科学)[^。；，]{0,14}(授予|颁给|花落|桂冠|得奖|夺奖|荣获|获得|颁奖|摘得|揭晓)",
      "获[^。；，]{0,6}(诺贝尔|诺奖|普利策|图灵|菲尔兹|格莱美|奥斯卡|金球|布克|雨果|艾美|金棕榈)"
    ],
    "weakSignals": ["提名", "入围", "有望", "或成", "或将", "预测", "候选", "竞逐", "角逐", "退出", "缺席", "拒绝", "抵制", "落选", "错失", "无缘", "陪跑", "呼声"],
    "floors": {
      "_note": "地板分（各维度取 max(cur, floor)）。取值经反推校准：archiveValue = weighted*0.40 + max*0.60，只有把最高维抬到 85/88 才能跨过 KEEP 线 70。",
      "science":     {"globalImpact": 45, "socialImpact": 35, "culturalImpact": 55, "economicImpact": 20, "technologyImpact": 85, "memoryValue": 75},
      "humanities":  {"globalImpact": 45, "socialImpact": 40, "culturalImpact": 88, "economicImpact": 18, "technologyImpact": 15, "memoryValue": 78}
